+/*
+ * BBR-TAS pacing shift selection.
+ * Unlike BBR-BVR's bbr_fc_update_pacing_shift(), this version:
+ *   (i)  reads the shift values from module parameters, so they can be
+ *        swept externally for the STARTUP x steady-state factorial
+ *        design (9/8/7 x 10/9/8), and
+ *   (ii) treats BBR_DRAIN the same as BBR_STARTUP, since DRAIN is still
+ *        part of the initial ramp-up window in which a larger TSQ
+ *        allowance helps frame aggregation rather than harming latency.
+ * ProbeBW gains, MIN_SEGS, and quantum computation are untouched.
+ */
+static void bbr_tas_update_pacing_shift(struct sock *sk)
 {
-    struct bbr *bbr = inet_csk_ca(sk);
+	struct bbr *bbr = inet_csk_ca(sk);
+	int shift;
 
-    if (bbr->mode == BBR_STARTUP) {
-        if (sk->sk_pacing_shift != BBR_FC_PACING_SHIFT_STARTUP)
-            sk->sk_pacing_shift = BBR_FC_PACING_SHIFT_STARTUP;
-    } else {
-        if (sk->sk_pacing_shift != BBR_FC_PACING_SHIFT_STEADY)
-            sk->sk_pacing_shift = BBR_FC_PACING_SHIFT_STEADY;
-    }
+	if (bbr->mode == BBR_STARTUP || bbr->mode == BBR_DRAIN)
+		shift = tas_pacing_shift_startup;
+	else
+		shift = tas_pacing_shift_steady;
+
+	if (sk->sk_pacing_shift != shift)
+		sk->sk_pacing_shift = shift;
 }
